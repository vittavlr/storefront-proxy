# Base URL of your EXISTING billing server. No trailing slash.
BILLING_API_BASE=https://your-billing-api.example.com

# Base URL of your EXISTING billing client (where PublicInvoicePage is
# hosted) — used to build the "View bill" links. No trailing slash.
BILLING_CLIENT_URL=https://your-billing-app.example.com

# The Business.id this storefront serves (one business per proxy).
BUSINESS_ID=paste-your-business-id-here

# Login for a staff account in your billing app, used ONLY by this
# server to call your existing API — never sent to the browser.
# Needs at least CASHIER role (products/customers/invoices are
# readable by any role, but creating a share link requires
# OWNER/MANAGER/CASHIER). Consider making a dedicated account for
# this instead of reusing your own login.
STAFF_EMAIL=storefront@yourshop.example.com
STAFF_PASSWORD=change-me

# Where this proxy itself will be hosted — only that origin is allowed
# to call it from a browser.
ALLOWED_ORIGIN=https://your-ordering-site.example.com

# Password for the storefront's own admin screen (site text + incoming
# requests). Separate from your billing login on purpose — pick your
# own value.
ADMIN_PASSWORD=change-me-too

PORT=4100

# OPTIONAL. Keep orders and site text in Supabase so they survive redeploys.
# Leave both out and the proxy keeps using its disk files as before.
# Set these on the host (Render > Environment) only. Never commit them.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=

# OPTIONAL. Push notifications through the Universe app (new order alerts staff, status changes alert the customer).
# NOTIFY_URL is https://YOUR-UNIVERSE-PROJECT-REF.supabase.co/functions/v1/notify-events
# NOTIFY_SECRET is the same WEBHOOK_SECRET the notify-events function uses. Set both on the host only. Never commit them.
NOTIFY_URL=
NOTIFY_SECRET=
